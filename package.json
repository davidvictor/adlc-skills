{
  "name": "adlc-cli",
  "version": "0.1.0",
  "description": "Agent-driven lifecycle tooling for Codex, Claude, and Hermes workstreams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidvictor/adlc-skills.git"
  },
  "homepage": "https://github.com/davidvictor/adlc-skills#readme",
  "bugs": {
    "url": "https://github.com/davidvictor/adlc-skills/issues"
  },
  "keywords": [
    "adlc",
    "codex",
    "claude",
    "hermes",
    "agents",
    "workstreams"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
  "bin": {
    "adlc": "./bin/adlc.js"
  },
  "files": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "bin",
    "docs",
    "extensions",
    "mcp",
    "schemas",
    "scripts",
    "skills",
    "subagents",
    "templates"
  ],
  "scripts": {
    "adlc": "node bin/adlc.js",
    "list": "bash scripts/list-adlc.sh",
    "validate": "bash scripts/validate-adlc.sh",
    "test:cli": "bash scripts/test-adlc-cli.sh",
    "test:skill-fixtures": "bash scripts/test-adlc-skill-fixtures.sh",
    "test:package-smoke": "bash scripts/test-package-smoke.sh",
    "audit:artifacts": "node bin/adlc.js audit-artifacts",
    "agents": "node bin/adlc.js agents",
    "init": "node bin/adlc.js init",
    "status": "node bin/adlc.js status",
    "update": "node bin/adlc.js update",
    "doctor": "node bin/adlc.js doctor",
    "uninstall": "node bin/adlc.js uninstall",
    "resolve:config": "node bin/adlc.js resolve-config",
    "workstream": "node bin/adlc.js workstream",
    "mcp:list": "node bin/adlc.js mcp list",
    "extension:list": "node bin/adlc.js extension list",
    "pack:dry-run": "npm --cache /private/tmp/adlc-npm-cache pack --dry-run"
  }
}
